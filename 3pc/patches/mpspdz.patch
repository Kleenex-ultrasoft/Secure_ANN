+        auto pi_a = permutation(prngs[0]);
+        auto pi_b = permutation(prngs[1]);
+        vector<clear> x(size);
+        auto z_a = randoms(prngs[0]);
+        for (size_t j = 0; j < size; j++)
+            x[j] = S[source + j].sum() + z_a[j];
