+    :param: number of arguments to follow (seven)
+    :param: number of bits per entry (int)
+    :param: address of destination entry 0 (regint)
+    :param: address of destination indices in integer memory (regint)
+    :param: address of source entry 0 (regint)
+    :param: address of source indices in integer memory (regint)
+    :param: count (regint)
+    :param: 1 to assign instead of XOR (int)
+    """
+    code = opcodes['XORMEMB']
+    arg_format = ['int','ci','ci','ci','ci','ci','int']
+
+    def has_var_args(self):
+        return True
+
+class xorandmemb(base.DoNotEliminateInstruction, base.VarArgsInstruction):
+    """ XOR local products of entries of secret bit memory into other
+    entries (see :py:class:`localand` and :py:class:`xormemb`):
+    ``dest[dest_index[i]] ^= localand(a[a_index[i]], b[b_index[i]])``
+    for ``i`` below the count. No communication; the destination holds
+    additive sharings.
+
+    :param: number of arguments to follow (eight)
