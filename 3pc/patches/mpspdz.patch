+class localand(BinaryVectorInstruction):
+    """ Bitwise AND of secret bit register vectors without communication.
+    The result is an additive sharing of the product (every party holds
+    one summand) instead of a replicated sharing. It can be combined
+    with XOR and with AND by clear bits, and it has to be opened with
+    :py:class:`revealsum`. Only for semi-honest three-party replicated
+    secret sharing.
+
+    :param: number of arguments to follow (multiple of four)
+    :param: number of bits (int)
+    :param: result (sbit)
+    :param: operand (sbit)
+    :param: operand (sbit)
+    :param: (repeat from number of bits)...
+    """
+    code = opcodes['LOCALAND']
+    arg_format = tools.cycle(['int','sbw','sb','sb'])
+
+class revealsum(BinaryVectorInstruction, base.VarArgsInstruction, base.Mergeable):
+    """ Reveal secret bit register vectors that hold additive or
+    replicated sharings and copy the result to clear bit register
+    vectors. Every party sends its summand, masked with a fresh sharing
+    of zero, to both other parties, so that the product of two
+    replicated sharings (see :py:class:`localand`) is opened in one round.
+
+    :param: number of arguments to follow (multiple of three)
+    :param: number of bits (int)
+    :param: destination (cbit)
+    :param: source (sbit)
+    :param: (repeat from number of bits)...
+    """
+    code = opcodes['REVEALSUM']
+    arg_format = tools.cycle(['int','cbw','sb'])
+
+    def add_usage(self, req_node):
+        req_node.increment(('bit', 'open'), sum(
+            int(math.ceil(x / 64)) * 8 for x in self.args[0::3]))
+
