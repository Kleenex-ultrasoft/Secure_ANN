+        }
+    }
+    else if (me == 1)
+    {
+        auto pi_a = permutation(prngs[1]);
+        auto pi_c = permutation(prngs[0]);
+        vector<clear> y(size);
+        auto z_a = randoms(prngs[1]);
+        for (size_t j = 0; j < size; j++)
+            y[j] = S[source + j][0] - z_a[j];
+        y = permute(y, pi_a);
+        pack(y, to_send[2]);
+        P.send_first_receive_all(first, to_send, received);
+
+        auto x = unpack(size, received[0]);
+        auto z_c = randoms(prngs[0]);
+        for (size_t j = 0; j < size; j++)
+            x[j] += z_c[j];
+        x = permute(x, pi_c);
+
+        auto y_0 = randoms(prngs[1]);
+        vector<clear> c_1(size), u_1;
+        for (size_t j = 0; j < size; j++)
+            c_1[j] = x[j] - y_0[j];
+        for (auto& os : to_send)
+            os.reset_write_head();
+        pack(c_1, to_send[2]);
+        if (n_bits > 0)
+        {
+            for (size_t j = 0; j < rows; j++)
+                u_1.push_back(reduce(x[j * unit] + S[mask + j][1]));
+            pack(u_1, to_send[2]);
+            if (not pair)
+                pack(u_1, to_send[0]);
+        }
+        P.send_first_receive_all(second, to_send, received);
+
+        auto c_2 = unpack(size, received[2]);
+        for (size_t j = 0; j < size; j++)
+        {
+            S[dest + j][0] = c_1[j] + c_2[j];
+            S[dest + j][1] = y_0[j];
+        }
+        if (n_bits > 0)
+        {
+            auto u_2 = unpack(rows, received[2]);
+            for (size_t j = 0; j < rows; j++)
+                C[opened + j] = clear(u_1[j] + u_2[j]) >> (64 - n_bits);
+        }
+    }
+    else
+    {
+        auto pi_b = permutation(prngs[0]);
+        auto pi_c = permutation(prngs[1]);
+        P.send_first_receive_all(first, to_send, received);
+
+        auto y = unpack(size, received[1]);
+        auto z_b = randoms(prngs[0]);
+        for (size_t j = 0; j < size; j++)
+            y[j] -= z_b[j];
+        y = permute(y, pi_b);
+        auto z_c = randoms(prngs[1]);
+        for (size_t j = 0; j < size; j++)
+            y[j] -= z_c[j];
+        y = permute(y, pi_c);
+
+        auto y_2 = randoms(prngs[0]);
+        vector<clear> c_2(size), u_2;
+        for (size_t j = 0; j < size; j++)
+            c_2[j] = y[j] - y_2[j];
+        pack(c_2, to_send[1]);
+        if (n_bits > 0)
