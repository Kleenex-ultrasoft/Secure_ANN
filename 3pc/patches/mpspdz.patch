+            S[dest + j][1] = c_1[j] + c_2[j];
+        }
+        if (n_bits > 0)
+        {
+            auto u_1 = unpack(rows, received[1]);
+            for (size_t j = 0; j < rows; j++)
+                C[opened + j] = clear(u_1[j] + u_2[j]) >> (64 - n_bits);
+        }
