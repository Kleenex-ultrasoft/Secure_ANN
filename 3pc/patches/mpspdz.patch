+/*
+ * Additive sharing of a AND b. With replicated shares, party i can compute
+ * z_i = a_i b_i + a_i b_{i-1} + a_{i-1} b_i on its own, and the three z_i
+ * add up to the product. The result register holds (z_i, 0): it is not a
+ * replicated sharing, but XOR and AND with clear bits act on it summand by
+ * summand, and so does XOR with a replicated sharing, whose first component
+ * is the party's summand.
+ */
+inline void SemiHonestRepSecret::localand(
+        Processor<SemiHonestRepSecret>& processor, const ArgVector& args)
+{
+    assert(args.size() % 4 == 0);
+    auto& S = processor.S;
+    const int unit = SemiHonestRepSecret::default_length;
+
+    for (size_t i = 0; i < args.size(); i += 4)
+    {
+        int n = args[i];
+        for (int j = 0; j < DIV_CEIL(n, unit); j++)
+        {
+            int n_bits = min(unit, n - j * unit);
+            BitVec z = S[args[i + 2] + j].local_mul(S[args[i + 3] + j]);
+            auto& res = S[args[i + 1] + j];
+            res[0] = z.mask(n_bits);
+            res[1] = 0;
+        }
+    }
+}
+
+/*
+ * Opens sharings given by one summand per party (the first component of
+ * the register). Party i sends z_i = x_i + alpha_i to both other parties,
+ * where the alpha_i are a fresh sharing of zero derived from the pairwise
+ * seeds. Each z_i on its own is masked by a seed that the receiver does not
+ * hold, and the three of them add up to the secret.
+ */
+inline void SemiHonestRepSecret::revealsum(
+        Processor<SemiHonestRepSecret>& processor, const ArgVector& args)
+{
+    auto& party = ShareThread<SemiHonestRepSecret>::s();
+    party.check();
+    assert(args.size() % 3 == 0);
+    auto& protocol = *party.protocol;
+    auto& P = *party.P;
+    auto& S = processor.S;
+    const int unit = SemiHonestRepSecret::default_length;
+
+    vector<BitVec> mine;
+    octetStream os;
+    for (size_t i = 0; i < args.size(); i += 3)
+    {
+        int n = args[i];
+        for (int j = 0; j < DIV_CEIL(n, unit); j++)
+        {
+            int n_bits = min(unit, n - j * unit);
+            BitVec tmp[2];
+            for (int k = 0; k < 2; k++)
+                tmp[k].randomize(protocol.shared_prngs[k], n_bits);
+            BitVec z = (S[args[i + 2] + j][0] + tmp[0] - tmp[1]).mask(n_bits);
+            mine.push_back(z);
+            os.store_int(z.get(), DIV_CEIL(n_bits, 8));
+        }
+    }
+
+    // one round: to and from both other parties
+    vector<octetStream> to_send(3, os), received(3);
+    P.send_receive_all(to_send, received);
+    protocol.rounds++;
+
+    size_t pos = 0;
+    for (size_t i = 0; i < args.size(); i += 3)
+    {
+        int n = args[i];
+        for (int j = 0; j < DIV_CEIL(n, unit); j++)
+        {
+            int n_bits = min(unit, n - j * unit);
+            BitVec res = mine[pos++];
+            for (int k = 0; k < 3; k++)
+                if (k != P.my_num())
