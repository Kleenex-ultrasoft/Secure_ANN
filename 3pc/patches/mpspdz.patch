+    :param: address of the indices into b in integer memory (regint)
+    :param: count (regint)
+    :param: (repeat from number of bits)...
+    """
+    code = opcodes['ANDMEMB']
+    arg_format = tools.cycle(['int','ci','ci','ci','ci','ci','ci'])
+
