+template <class T>
+void Processor<T>::localand(const ArgVector& args)
+{
+    if constexpr (requires { T::localand(*this, args); })
+        T::localand(*this, args);
+    else
+        throw runtime_error("LOCALAND is only implemented for semi-honest "
+                "three-party replicated secret sharing");
+}
+
+template <class T>
+void Processor<T>::revealsum(const ArgVector& args)
+{
+    if constexpr (requires { T::revealsum(*this, args); })
+        T::revealsum(*this, args);
+    else
+        throw runtime_error("REVEALSUM is only implemented for semi-honest "
+                "three-party replicated secret sharing");
+}
+
+/*
+ * dest[dest_index[i]] ^= source[source_index[i]] (or = if args[6] is set)
+ * on entries of DIV_CEIL(args[0], unit) cells of secret bit memory.
+ * registers: integer registers, indices: integer memory.
+ */
+template <class T>
+template <class U, class V>
+void Processor<T>::xor_memory(const ArgVector& args, const U& registers,
+        const V& indices)
+{
+    assert(args.size() == 7);
+    const int n_bits = args[0];
+    const long cells = DIV_CEIL(n_bits, T::default_length);
+    const long dest = registers[args[1]].get();
+    const long dest_index = registers[args[2]].get();
+    const long source = registers[args[3]].get();
+    const long source_index = registers[args[4]].get();
+    const long count = registers[args[5]].get();
+    const bool assign = args[6];
+    auto& M = memories.MS;
+
+    for (long i = 0; i < count; i++)
+    {
+        long d = dest + indices[dest_index + i].get() * cells;
+        long s = source + indices[source_index + i].get() * cells;
+        M.check_index(d + cells - 1);
+        M.check_index(s + cells - 1);
+        for (long j = 0; j < cells; j++)
+        {
+            int n = min(long(T::default_length), n_bits - j * T::default_length);
+            if (assign)
+                M[d + j] = M[s + j];
+            else
+                M[d + j].xor_(n, M[d + j], M[s + j]);
+        }
+    }
+}
+
+/*
+ * dest[i] = a[a_index[i]] AND b[b_index[i]] on entries of
+ * DIV_CEIL(args[0], unit) cells of secret bit memory, for all groups of
+ * seven arguments in one round.
+ */
+template <class T>
+template <class U, class V>
+void Processor<T>::and_memory(const ArgVector& args, const U& registers,
+        const V& indices)
+{
+    assert(args.size() % 7 == 0);
+    auto& M = memories.MS;
+
+    if constexpr (requires (T x) {
+            ShareThread<T>::s().protocol->prepare_mult(x, x, 1, false);
+            ShareThread<T>::s().protocol->finalize_mult(x, 1); })
+    {
+        auto& protocol = *ShareThread<T>::s().protocol;
+        protocol.init_mul();
+        T x, y;
+
+        // calls f(group, i, j, n): entry i of a group, cell j with n bits
+        auto for_all = [&](auto f)
+        {
+            for (size_t g = 0; g < args.size(); g += 7)
+            {
+                const int n_bits = args[g];
+                const long cells = DIV_CEIL(n_bits, T::default_length);
+                const long count = registers[args[g + 6]].get();
+                for (long i = 0; i < count; i++)
+                    for (long j = 0; j < cells; j++)
+                        f(g, i, j, min(long(T::default_length),
+                                n_bits - j * T::default_length), cells);
+            }
+        };
+
+        for_all([&](size_t g, long i, long j, int n, long cells)
+        {
+            long a = registers[args[g + 2]].get()
+                    + indices[registers[args[g + 3]].get() + i].get() * cells + j;
+            long b = registers[args[g + 4]].get()
+                    + indices[registers[args[g + 5]].get() + i].get() * cells + j;
+            M.check_index(a);
+            M.check_index(b);
+            M[a].mask(x, n);
+            M[b].mask(y, n);
+            protocol.prepare_mult(x, y, n, false);
+        });
+
+        protocol.exchange();
+
+        for_all([&](size_t g, long i, long j, int n, long cells)
+        {
+            long d = registers[args[g + 1]].get() + i * cells + j;
+            M.check_index(d);
+            protocol.finalize_mult(M[d], n);
+        });
+    }
+    else
+        throw runtime_error("ANDMEMB is not implemented for this protocol");
+}
+
+/*
+ * dest[dest_index[i]] ^= local product of a[a_index[i]] and b[b_index[i]]
+ * (an additive sharing, see localand) on entries of DIV_CEIL(args[0], unit)
+ * cells of secret bit memory.
+ */
+template <class T>
+template <class U, class V>
+void Processor<T>::xor_and_memory(const ArgVector& args, const U& registers,
+        const V& indices)
+{
+    assert(args.size() == 8);
+    auto& M = memories.MS;
+
+    if constexpr (requires (T x) { x[0] += x.local_mul(x); })
+    {
+        const int n_bits = args[0];
+        const long cells = DIV_CEIL(n_bits, T::default_length);
+        const long dest = registers[args[1]].get();
+        const long dest_index = registers[args[2]].get();
+        const long a = registers[args[3]].get();
+        const long a_index = registers[args[4]].get();
+        const long b = registers[args[5]].get();
+        const long b_index = registers[args[6]].get();
+        const long count = registers[args[7]].get();
+        for (long i = 0; i < count; i++)
+        {
+            long d = dest + indices[dest_index + i].get() * cells;
+            long x = a + indices[a_index + i].get() * cells;
+            long y = b + indices[b_index + i].get() * cells;
+            M.check_index(d + cells - 1);
+            M.check_index(x + cells - 1);
+            M.check_index(y + cells - 1);
+            for (long j = 0; j < cells; j++)
+            {
+                int n = min(long(T::default_length),
+                        n_bits - j * T::default_length);
+                M[d + j][0] += M[x + j].local_mul(M[y + j]).mask(n);
+            }
+        }
+    }
+    else
+        throw runtime_error("XORANDMEMB is only implemented for semi-honest "
+                "three-party replicated secret sharing");
+}
