+class shuffleopen(base.VarArgsInstruction):
+    """ Secure shuffle of rows of secret registers in two rounds,
+    optionally together with the opening of the first entry of every
+    shuffled row plus a secret mask. The opening happens in the second
+    round of the shuffle. The rows can be divided into blocks of equal
+    size that are shuffled independently. Only for semi-honest
+    three-party replicated secret sharing.
+
+    :param: number of arguments to follow (nine)
+    :param: number of registers, rows times row length (int)
+    :param: destination (sint)
+    :param: source (sint)
+    :param: row length (int)
+    :param: number of bits to open of every masked entry, 0 for none (int)
+    :param: masks, one per row (sint)
+    :param: opened values, one per row (cint)
+    :param: number of blocks (int)
+    :param: 1 to open to parties 1 and 2 only, as :py:class:`cmpopen` needs (int)
+    """
+    __slots__ = []
+    code = base.opcodes['SHUFFLEOPEN']
+    arg_format = ['int','sw','s','int','int','s','cw','int','int']
+    is_vec = lambda self: True
+
+    def __init__(self, *args, **kwargs):
+        super(shuffleopen, self).__init__(*args, **kwargs)
+        size, dest, source, unit, n_bits, mask, opened, blocks, pair = args
+        assert size == len(dest) == len(source)
+        assert size % (unit * blocks) == 0
+        assert 0 <= n_bits <= 64
+        assert len(mask) == len(opened) == size // unit
+
+    def has_var_args(self):
+        return True
