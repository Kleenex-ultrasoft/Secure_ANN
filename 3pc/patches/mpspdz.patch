+/*
+ * Shuffle in two rounds, with the masked opening of one column.
+ *
+ * args: number of registers (rows * unit), destination, source, unit (row
+ * length), n_bits, masks (one register per row), opened values (one clear
+ * register per row), blocks (the rows are divided into this many blocks of
+ * equal size, and rows only move within their block), pair (the masked
+ * values are opened to parties 1 and 2 only, see prepare_compare).
+ *
+ * Party i holds (x_i, x_{i-1}) of x = x_0 + x_1 + x_2 and the seeds s_i
+ * (with party i+1) and s_{i-1}. Every seed gives a permutation of the rows:
+ * pi_a from s_0, pi_b from s_2, pi_c from s_1. The rows are permuted by
+ * pi_c pi_b pi_a, which no party knows.
+ *
+ *   round 1   P0 -> P1:  X2 = pi_b(pi_a(x_0 + x_2 + Z_a) + Z_b)
+ *             P1 -> P2:  Y1 = pi_a(x_1 - Z_a)
+ *   locally   P1:        X3 = pi_c(X2 + Z_c)
+ *             P2:        Y3 = pi_c(pi_b(Y1 - Z_b) - Z_c)
+ *
+ * X3 + Y3 is the permuted array. The new sharing is y_0 from s_0, y_2 from
+ * s_2 and y_1 = (X3 - y_0) + (Y3 - y_2):
+ *
+ *   round 2   P1 -> P2:  X3 - y_0        P2 -> P1:  Y3 - y_2
+ *
+ * If n_bits > 0, the first entry of every shuffled row plus the mask r of
+ * the row is opened modulo 2^n_bits in round 2 as well: with r shared as
+ * (r_0, r_1, r_2), P1 sends X3 + r_0 and P2 sends Y3 + r_1 + r_2 to both
+ * other parties. A receiver lacks one of the summands of r or, in the case
+ * of P0, the mask Z_c, so a single message is uniformly random.
+ */
+template<class T>
+template<class U>
+void Rep3Shuffler<T>::shuffle_open(StackedVector<T>& S,
+        StackedVector<typename T::clear>& C, const U& args)
+{
+    typedef typename T::clear clear;
+
+    assert(proc.P.num_players() == 3);
+    assert(not T::malicious);
+    assert(not T::dishonest_majority);
+    assert(args.size() == 9);
+    const bool pair = args[8];
+
+    const size_t size = args[0], dest = args[1], source = args[2];
+    const size_t unit = args[3];
+    const int n_bits = args[4];
+    const size_t mask = args[5], opened = args[6];
+    const size_t rows = size / unit;
+    const size_t blocks = args[7];
+    const size_t block = rows / blocks;
+    assert(block * blocks * unit == size);
+
+    auto& P = proc.P;
+    auto& prngs = proc.protocol.shared_prngs;
+    const int me = P.my_num();
+
+    // prngs[0] is seed s_me, prngs[1] is seed s_{me-1}
+    auto permutation = [&](PRNG& G)
+    {
+        vector<int> perm(rows);
+        for (size_t j = 0; j < rows; j++)
+            perm[j] = j;
+        for (size_t start = 0; start < rows; start += block)
+            for (size_t j = 0; j < block; j++)
+                swap(perm[start + j],
+                        perm[start + j + G.get_uint_lemire(block - j)]);
+        return perm;
+    };
+    auto randoms = [&](PRNG& G)
+    {
+        vector<clear> res(size);
+        for (auto& x : res)
+            x.randomize(G);
+        return res;
+    };
+    auto permute = [&](const vector<clear>& in, const vector<int>& perm)
+    {
+        vector<clear> res(size);
+        for (size_t j = 0; j < rows; j++)
+            for (size_t k = 0; k < unit; k++)
+                res[j * unit + k] = in[perm[j] * unit + k];
+        return res;
+    };
+    auto pack = [&](const vector<clear>& values, octetStream& os)
+    {
+        os.reserve(values.size() * clear::size());
+        for (auto& x : values)
+            x.pack(os);
+    };
+    auto unpack = [&](size_t n, octetStream& os)
+    {
+        vector<clear> res(n);
+        for (auto& x : res)
+            x.unpack(os);
+        return res;
+    };
+
+    vector<vector<bool>> first(3, vector<bool>(3)), second(3, vector<bool>(3));
+    first[0][1] = first[1][2] = true;
+    second[1][2] = second[2][1] = true;
+    if (n_bits > 0 and not pair)
