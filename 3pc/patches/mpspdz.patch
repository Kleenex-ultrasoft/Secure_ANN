+      send_to_no_stats(i, to_send[i]);
+  for (int i = 0; i < num_players(); i++)
+    if (i != me and channels[me][i] and channels[i][me])
+      exchange_no_stats(i, to_send[i], to_receive[i]);
+  for (int i = 0; i < num_players(); i++)
+    if (i != me and channels[i][me] and not channels[me][i])
+      receive_player_no_stats(i, to_receive[i]);
