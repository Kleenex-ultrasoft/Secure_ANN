+
+/*
+ * Comparisons with party 0 as dealer.
+ *
+ * The values to compare sit at `size` positions; lane l compares the values
+ * at positions left[l] and right[l]. Party 0 chooses a mask r_i of `bits`
+ * bits for every position and never sees a masked value; parties 1 and 2
+ * see the masked values c_i = x_i + r_i but each knows only one of two
+ * summands of r_i. With rho = r_left - r_right,
+ *
+ *     x_left - x_right = (c_left - c_right) - rho      (modulo 2^bits),
+ *
+ * so the sign of the difference follows from the top bits and from whether
+ * the low bits of c_left - c_right are below those of rho. The low bits
+ * are cut into chunks. For every chunk, party 0 shares the table
+ * v -> [chunk of rho >= v] between parties 1 and 2, who look up, for the
+ * public chunk value v, shares of lt = [rho's chunk > v] and
+ * eq = [rho's chunk = v]. Then
+ *
+ *     [c < rho] = XOR_k  lt_k AND eq_{k+1} AND ... AND eq_{m-1}.
+ *
+ * Parties 1 and 2 open lt_k + alpha_k and eq_j + beta_j for random bits
+ * alpha, beta shared by party 0, expand the products and combine shares of
+ * the products of the alpha and beta, which party 0 also provides. That
+ * takes one round, opening the result another.
+ *
+ * Everything party 0 provides comes from the seed it shares with party 1,
+ * except for what it sends to party 2 in one message. Party 0 learns the
+ * comparison results only; a party that sees the c_i lacks one summand of
+ * every mask, table and product.
+ */
+template<class T>
+Rep3Shuffler<T>::CompareLayout::CompareLayout(int bits) : bits(bits)
+{
+    // chunks: the number that minimises what party 0 has to send
+    int low = bits - 1;
+    assert(low > 0 and low <= 62);
+    long best = -1;
+    n_chunks = 0;
+    for (int m = 1; m <= 10 and m <= low; m++)
+    {
+        if (DIV_CEIL(low, m) > 12)
+            continue;
+        long cost = (1L << (m - 1)) + (1L << m);
+        for (int k = 0; k < m; k++)
+            cost += (1L << (low / m + (k < low % m))) + 1;
+        if (best < 0 or cost < best)
+        {
+            best = cost;
+            n_chunks = m;
+        }
+    }
+    assert(n_chunks > 0);
+    table_bits = 0;
+    int pos = 0;
+    for (int k = 0; k < n_chunks; k++)
+    {
+        width.push_back(low / n_chunks + (k < low % n_chunks));
+        shift.push_back(pos);
+        offset.push_back(table_bits);
+        pos += width[k];
+        table_bits += (1 << width[k]) + 1;
+    }
+    table_bytes = DIV_CEIL(table_bits, 8);
+}
+
+/*
+ * args: -, destination of the masks (one secret register per position),
+ * size, bits, lanes. left, right: addresses of the positions of every lane
+ * in the integer memory `positions`. Returns a handle for compare_open.
+ */
+template<class T>
+template<class U, class V>
+long Rep3Shuffler<T>::prepare_compare(StackedVector<T>& S, const U& args,
+        long left, long right, const V& positions)
+{
+    typedef typename CompareMaterial::plane plane;
+
+    assert(proc.P.num_players() == 3);
+    assert(not T::malicious);
+    assert(not T::dishonest_majority);
+
+    auto& P = proc.P;
+    auto& prngs = proc.protocol.shared_prngs;
+    const int me = P.my_num();
+    const size_t mask = args[1], size = args[2];
+    const int bits = args[3];
+    const size_t lanes = args[4];
+    const size_t words = DIV_CEIL(lanes, 64);
+    const word low_bits = (word(1) << bits) - 1;
+
+    CompareLayout layout(bits);
+    const int m = layout.n_chunks;
+    const size_t n_subsets = layout.n_subsets();
+
+    auto& material = compare_store[n_compare];
+    material.size = size;
+    material.lanes = lanes;
+    for (size_t l = 0; l < lanes; l++)
+    {
+        material.left.push_back(positions[left + l].get());
+        material.right.push_back(positions[right + l].get());
+    }
+
+    auto random_words = [&](PRNG& G, size_t n)
+    {
+        vector<word> res(n);
+        G.get_octets((octet*) res.data(), n * sizeof(word));
+        return res;
+    };
+    auto random_plane = [&](PRNG& G) { return random_words(G, words); };
+    auto add = [&](const plane& x, const plane& y)
+    {
+        plane res(words);
+        for (size_t i = 0; i < words; i++)
+            res[i] = x[i] ^ y[i];
+        return res;
+    };
+    auto mul = [&](const plane& x, const plane& y)
+    {
+        plane res(words);
+        for (size_t i = 0; i < words; i++)
+            res[i] = x[i] & y[i];
+        return res;
+    };
+    // subsets S of {1..m-1} are bit masks shifted by one; these are the
+    // ones with at least two elements, and the non-empty subsets of
+    // {k+1..m-1}
+    auto large = [&](size_t s) { return (s & (s - 1)) != 0; };
+    auto above = [&](size_t s, int k) { return s != 0 and (s >> k) << k == s; };
+
+    vector<vector<bool>> channels(3, vector<bool>(3));
+    channels[0][2] = true;
+    vector<octetStream> to_send(3), received(3);
+
+    material.products.resize(n_subsets);
+    material.lower_products.assign(m, vector<plane>(n_subsets));
+
+    if (me == 0)
+    {
+        // seed with party 1, seed with party 2
+        auto& G1 = prngs[0];
+        auto& G2 = prngs[1];
+        auto r_1 = random_words(G1, size);
+        auto r_2 = random_words(G2, size);
+        for (size_t i = 0; i < size; i++)
+        {
+            r_1[i] &= low_bits;
+            r_2[i] &= low_bits;
+            S[mask + i][0] = typename T::clear(r_1[i]);
+            S[mask + i][1] = typename T::clear(r_2[i]);
+        }
+
+        // tables: entry v of chunk k is [chunk >= v]
+        vector<octet> tables(lanes * layout.table_bytes);
+        G1.get_octets(tables.data(), tables.size());
+        plane top(words);
+        for (size_t l = 0; l < lanes; l++)
+        {
+            word rho = (r_1[material.left[l]] + r_2[material.left[l]]
+                    - r_1[material.right[l]] - r_2[material.right[l]])
+                    & low_bits;
+            octet* table = &tables[l * layout.table_bytes];
+            for (int k = 0; k < m; k++)
+            {
+                size_t chunk = (rho >> layout.shift[k])
+                        & ((word(1) << layout.width[k]) - 1);
+                size_t first = layout.offset[k];
+                for (size_t v = first; v <= first + chunk; v++)
+                    table[v / 8] ^= 1 << (v % 8);
+            }
+            top[l / 64] |= ((rho >> (bits - 1)) & 1) << (l % 64);
+        }
+        auto& os = to_send[2];
+        os.append(tables.data(), tables.size());
+        auto send = [&](const plane& x)
+        {
+            os.append((octet*) x.data(), words * sizeof(word));
+        };
+
+        vector<plane> alpha, beta(1), all(n_subsets);
+        for (int k = 0; k < m; k++)
+            alpha.push_back(random_plane(G1));
+        for (int j = 1; j < m; j++)
+            beta.push_back(random_plane(G1));
+        for (int k = 0; k < m; k++)
+            alpha[k] = add(alpha[k], random_plane(G2));
+        for (int j = 1; j < m; j++)
+            beta[j] = add(beta[j], random_plane(G2));
+        // products of the beta
+        all[0] = plane(words, word(-1));
+        for (size_t s = 1; s < n_subsets; s++)
+        {
+            int j = __builtin_ctzl(s);
+            all[s] = mul(all[s & (s - 1)], beta[j + 1]);
+        }
+        for (size_t s = 1; s < n_subsets; s++)
+            if (large(s))
+                send(add(all[s], random_plane(G1)));
+        for (int k = 0; k < m; k++)
+            for (size_t s = 1; s < n_subsets; s++)
+                if (above(s, k))
+                    send(add(mul(alpha[k], all[s]), random_plane(G1)));
+        send(add(top, random_plane(G1)));
+        P.send_first_receive_all(channels, to_send, received);
+    }
+    else if (me == 1)
+    {
+        auto& G = prngs[1];
+        auto r = random_words(G, size);
+        for (size_t i = 0; i < size; i++)
+        {
+            S[mask + i][0] = {};
+            S[mask + i][1] = typename T::clear(r[i] & low_bits);
+        }
+        material.tables.resize(lanes * layout.table_bytes);
+        G.get_octets(material.tables.data(), material.tables.size());
+        for (int k = 0; k < m; k++)
+            material.alpha.push_back(random_plane(G));
+        material.beta.resize(1);
+        for (int j = 1; j < m; j++)
+            material.beta.push_back(random_plane(G));
+        for (size_t s = 1; s < n_subsets; s++)
+            if (large(s))
+                material.products[s] = random_plane(G);
+        for (int k = 0; k < m; k++)
+            for (size_t s = 1; s < n_subsets; s++)
+                if (above(s, k))
+                    material.lower_products[k][s] = random_plane(G);
+        material.top = random_plane(G);
+        P.send_first_receive_all(channels, to_send, received);
+    }
+    else
+    {
+        auto& G = prngs[0];
+        auto r = random_words(G, size);
+        for (size_t i = 0; i < size; i++)
+        {
+            S[mask + i][0] = typename T::clear(r[i] & low_bits);
+            S[mask + i][1] = {};
+        }
+        for (int k = 0; k < m; k++)
+            material.alpha.push_back(random_plane(G));
+        material.beta.resize(1);
+        for (int j = 1; j < m; j++)
+            material.beta.push_back(random_plane(G));
+        P.send_first_receive_all(channels, to_send, received);
+        auto& os = received[0];
+        material.tables.resize(lanes * layout.table_bytes);
+        os.consume(material.tables.data(), material.tables.size());
+        auto receive = [&]()
+        {
+            plane res(words);
+            os.consume((octet*) res.data(), words * sizeof(word));
+            return res;
+        };
+        for (size_t s = 1; s < n_subsets; s++)
+            if (large(s))
+                material.products[s] = receive();
+        for (int k = 0; k < m; k++)
+            for (size_t s = 1; s < n_subsets; s++)
+                if (above(s, k))
+                    material.lower_products[k][s] = receive();
+        material.top = receive();
+    }
+
+    if (me != 0)
+    {
+        // products of one element are the shares of alpha and beta
+        for (int j = 1; j < m; j++)
+            material.products[size_t(1) << (j - 1)] = material.beta[j];
+    }
+
+    return n_compare++;
+}
+
+/*
+ * args: lanes, destination (one clear register per lane, 1 if the value at
+ * the left position is smaller), -, masked values (one clear register per
+ * position, as parties 1 and 2 see them), bits. Two rounds. The material
+ * of the handle is used up.
+ */
+template<class T>
+template<class U>
+void Rep3Shuffler<T>::compare_open(StackedVector<typename T::clear>& C,
+        const U& args, long handle)
+{
+    typedef typename CompareMaterial::plane plane;
+    typedef typename T::clear clear;
+
+    auto& P = proc.P;
+    auto& prngs = proc.protocol.shared_prngs;
+    const int me = P.my_num();
+    const size_t lanes = args[0], dest = args[1], opened = args[3];
+    const int bits = args[4];
+    const size_t words = DIV_CEIL(lanes, 64);
+
+    auto it = compare_store.find(handle);
+    if (it == compare_store.end())
+        throw runtime_error("comparison material missing or used before");
+    auto& material = it->second;
+    if (material.lanes != lanes)
+        throw runtime_error("comparison material does not fit");
+
+    CompareLayout layout(bits);
+    const int m = layout.n_chunks;
+    const size_t n_subsets = layout.n_subsets();
+
+    vector<vector<bool>> first(3, vector<bool>(3)), second(3, vector<bool>(3));
+    first[1][2] = first[2][1] = true;
+    second[1][2] = second[2][1] = second[1][0] = second[2][0] = true;
+    vector<octetStream> to_send(3), received(3);
+    plane result(words);
+
+    if (me == 0)
+    {
+        P.send_first_receive_all(first, to_send, received);
+        P.send_first_receive_all(second, to_send, received);
+        for (int k = 1; k <= 2; k++)
+            for (size_t i = 0; i < words; i++)
+            {
+                word x;
+                received[k].consume((octet*) &x, sizeof(word));
+                result[i] ^= x;
+            }
+    }
+    else
+    {
+        const int other = 3 - me;
+        const word low_bits = (word(1) << bits) - 1;
+        // shares of lt_k and eq_k for the public chunk values, then masked
+        vector<plane> lt(m, plane(words)), eq(m, plane(words));
+        plane top(words);
+        for (size_t l = 0; l < lanes; l++)
+        {
+            word diff = (C[opened + material.left[l]].get_limb(0)
+                    - C[opened + material.right[l]].get_limb(0)) & low_bits;
+            const octet* table = &material.tables[l * layout.table_bytes];
+            for (int k = 0; k < m; k++)
+            {
+                size_t v = layout.offset[k] + ((diff >> layout.shift[k])
+                        & ((word(1) << layout.width[k]) - 1));
+                word at_least = (table[v / 8] >> (v % 8)) & 1;
+                word larger = (table[(v + 1) / 8] >> ((v + 1) % 8)) & 1;
+                lt[k][l / 64] |= larger << (l % 64);
+                eq[k][l / 64] |= (at_least ^ larger) << (l % 64);
+            }
+            top[l / 64] |= (diff >> (bits - 1)) << (l % 64);
+        }
+        auto& os = to_send[other];
+        for (int k = 0; k < m; k++)
+        {
+            for (size_t i = 0; i < words; i++)
+                lt[k][i] ^= material.alpha[k][i];
+            os.append((octet*) lt[k].data(), words * sizeof(word));
+        }
+        for (int j = 1; j < m; j++)
+        {
+            for (size_t i = 0; i < words; i++)
+                eq[j][i] ^= material.beta[j][i];
+            os.append((octet*) eq[j].data(), words * sizeof(word));
+        }
+        P.send_first_receive_all(first, to_send, received);
+        auto& is = received[other];
+        for (int k = 0; k < m; k++)
+            for (size_t i = 0; i < words; i++)
+            {
+                word x;
+                is.consume((octet*) &x, sizeof(word));
+                lt[k][i] ^= x;
+            }
+        for (int j = 1; j < m; j++)
+            for (size_t i = 0; i < words; i++)
+            {
+                word x;
+                is.consume((octet*) &x, sizeof(word));
+                eq[j][i] ^= x;
+            }
+
+        // lt and eq now hold d_k = lt_k + alpha_k and e_j = eq_j + beta_j.
+        // (d_k + alpha_k) prod_{j > k} (e_j + beta_j) is the sum over the
+        // subsets S of {k+1..m-1} of
+        //   prod_{j not in S} e_j * (d_k * prod_S beta + alpha_k * prod_S beta).
+        vector<plane> public_products(n_subsets);
+        public_products[0] = plane(words, word(-1));
+        for (size_t s = 1; s < n_subsets; s++)
+        {
+            int j = __builtin_ctzl(s);
+            auto& smaller = public_products[s & (s - 1)];
+            public_products[s].resize(words);
+            for (size_t i = 0; i < words; i++)
+                public_products[s][i] = smaller[i] & eq[j + 1][i];
+        }
+        // the public summand goes to party 1
+        if (me == 1)
+            result = top;
+        for (size_t i = 0; i < words; i++)
+            result[i] ^= material.top[i];
+        for (int k = 0; k < m; k++)
+        {
+            // subsets of {k+1..m-1}
+            size_t all = (n_subsets - 1) >> k << k;
+            for (size_t s = all;; s = (s - 1) & all)
+            {
+                auto& factor = public_products[all & ~s];
+                const plane* betas = s ? &material.products[s] : 0;
+                const plane& both = s ? material.lower_products[k][s]
+                        : material.alpha[k];
+                for (size_t i = 0; i < words; i++)
+                {
+                    word share = both[i];
+                    if (betas)
+                        share ^= lt[k][i] & (*betas)[i];
+                    else if (me == 1)
+                        share ^= lt[k][i];
+                    result[i] ^= factor[i] & share;
+                }
+                if (s == 0)
+                    break;
+            }
+        }
+
+        // open: a pad that party 0 does not know hides the shares
+        vector<word> pad(words);
+        prngs[me == 1 ? 0 : 1].get_octets((octet*) pad.data(),
+                words * sizeof(word));
+        for (size_t i = 0; i < words; i++)
+            result[i] ^= pad[i];
+        for (int k = 0; k < 3; k++)
+            to_send[k].reset_write_head();
+        to_send[other].append((octet*) result.data(), words * sizeof(word));
+        to_send[0].append((octet*) result.data(), words * sizeof(word));
+        P.send_first_receive_all(second, to_send, received);
+        for (size_t i = 0; i < words; i++)
+        {
+            word x;
+            received[other].consume((octet*) &x, sizeof(word));
+            result[i] ^= x;
+        }
+    }
+
+    for (size_t l = 0; l < lanes; l++)
+        C[dest + l] = clear((result[l / 64] >> (l % 64)) & 1);
+    compare_store.erase(it);
+}
+
+/*
+ * Opens the low n_bits bits of secret registers to parties 1 and 2 only:
+ * each of them sends the other the summand that the other lacks.
+ * args: size, destination (clear), source (secret), n_bits.
+ */
+template<class T>
+template<class U>
+void Rep3Shuffler<T>::open_pair(StackedVector<T>& S,
+        StackedVector<typename T::clear>& C, const U& args)
+{
+    typedef typename T::clear clear;
+
+    auto& P = proc.P;
+    const int me = P.my_num();
+    const size_t size = args[0], dest = args[1], source = args[2];
+    const int n_bits = args[3];
+
+    vector<vector<bool>> channels(3, vector<bool>(3));
+    channels[1][2] = channels[2][1] = true;
+    vector<octetStream> to_send(3), received(3);
+    if (me != 0)
+    {
+        // party i holds (x_i, x_{i-1}); 1 lacks x_2, 2 lacks x_0
+        const int other = 3 - me;
+        for (size_t i = 0; i < size; i++)
+            clear(S[source + i][me == 1 ? 1 : 0] << (64 - n_bits)).pack(
+                    to_send[other]);
+        P.send_first_receive_all(channels, to_send, received);
+        for (size_t i = 0; i < size; i++)
+        {
+            clear x;
+            x.unpack(received[other]);
+            C[dest + i] = clear(x + (S[source + i].sum() << (64 - n_bits)))
+                    >> (64 - n_bits);
+        }
+    }
+    else
+        P.send_first_receive_all(channels, to_send, received);
+}
+
 #endif
