+    :param: address of entry 0 of a (regint)
+    :param: address of the indices into a in integer memory (regint)
+    :param: address of entry 0 of b (regint)
+    :param: address of the indices into b in integer memory (regint)
+    :param: count (regint)
+    """
+    code = opcodes['XORANDMEMB']
+    arg_format = ['int','ci','ci','ci','ci','ci','ci','ci']
+
+    def has_var_args(self):
+        return True
+
+class andmemb(base.DoNotEliminateInstruction, base.VarArgsInstruction):
+    """ AND of entries of secret bit memory chosen by index arrays in
+    integer memory: ``dest[i] = a[a_index[i]] & b[b_index[i]]`` for
